{
  "name": "nest-desktop",
  "version": "0.1.0",
  "description": "Your Linux desktop, inside a window.",
  "main": "src/main.cjs",
  "author": "Nest contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/script-bot-afk/Nest.git"
  },
  "homepage": "https://github.com/script-bot-afk/Nest",
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "test:integration": "node --test test/integration.cjs",
    "dist": "npm run build && electron-builder --linux AppImage tar.gz --x64 --publish never",
    "pack": "npm run build && electron-builder --linux --dir --publish never",
    "test:ui": "node scripts/smoke.cjs"
  },
  "build": {
    "appId": "io.github.script-bot-afk.nest",
    "productName": "Nest",
    "artifactName": "Nest-${version}-${arch}.${ext}",
    "files": [
      "src/**",
      "dist/ui/**",
      "assets/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY.md"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "linux": {
      "category": "Utility",
      "icon": "assets/icon.png",
      "executableName": "nest",
      "synopsis": "A desktop inside your desktop",
      "desktop": {
        "entry": {
          "StartupWMClass": "Nest"
        }
      }
    }
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  }
}
